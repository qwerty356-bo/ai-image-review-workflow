# =====================================================
# 环境变量配置模板
# 复制本文件为 .env 并填入你的真实值（.env 已被 .gitignore 排除，不会上传）
# 若不想用环境变量，也可以直接修改 config.py / video_config.py
# =====================================================

# ---------- API（必填） ----------
# API 网关地址（config.py / video_config.py 读取）
API_BASE_URL=http://your-gateway-host/api-base

# 图片审核 API Key（config.py 读取）
IMAGE_API_KEY=sk-code-你的密钥

# 视频审核 API Key（video_config.py 读取；不设置则回退用 IMAGE_API_KEY）
# VIDEO_API_KEY=sk-code-你的密钥

# 模型名（可选，默认 doubao-seed-evolving）
# IMAGE_MODEL=doubao-seed-evolving
# VIDEO_MODEL=doubao-seed-evolving

# 请求 User-Agent（可选，默认 Python/requests；若网关要求特定 UA 请在此填写）
# API_USER_AGENT=YourUserAgent/1.0

# ---------- 路径（可选，不设置则用代码默认值） ----------
# 待审核图片文件夹
# IMAGE_DIR=/path/to/your/images

# 待审核视频文件夹
# VIDEO_DIR=/path/to/your/videos

# ffmpeg 安装路径（仅视频审核需要）
# FFMPEG_PATH=C:\path\to\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\path\to\ffmpeg\bin\ffprobe.exe

# 输出目录（默认：代码目录下 output/）
# OUTPUT_DIR=/path/to/your/output
